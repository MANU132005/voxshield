# VoxShield Backend Environment Configuration Example
PROJECT_NAME="VoxShield AI Voice Security API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Production Environment Settings
ENVIRONMENT="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Audio Limits
MAX_UPLOAD_SIZE_MB=15
MIN_AUDIO_DURATION_SECONDS=0.5

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30

# Production Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["https://voxshield.vercel.app","https://voxshield-frontend.vercel.app"]

LOG_LEVEL="INFO"
MODEL_PATH="models/asvspoof2019_la_recovery_exp01.pt"
